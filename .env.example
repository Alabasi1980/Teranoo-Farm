# GEMINI_API_KEY: Reserved for future smart farm advisor batch (not active in Batch 1).
# Do not commit real secrets or service account keys.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL injected at runtime.
APP_URL="MY_APP_URL"

# Firebase Web App Config (non-secret client identifiers; actual project config lives in firebase-applet-config.json)
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_WEB_APP_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
